# ================= PostgreSQL 数据库配置【团队模板，复制为.env后填写真实值】 =================
DB_USER=
DB_PASSWORD=
DB_NAME=
# 访问数据库地址
# ⚠️ HOST 取值取决于 Node 进程运行位置，不是数据库容器地址：
#   [Node在docker容器] 填服务名 postgres → docker-compose.local.yml 全量容器模式（Node+Postgres+Redis）
#   [Node在宿主机 npm run dev] 填 127.0.0.1（或 localhost）→ 走宿主机端口映射连接，develop 环境需在Node侧自行适配
DB_HOST=
DB_PORT=5432

# Prisma完整数据库连接串，复制到.env再启用
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ================= 连接池参数（db.config.ts 读取） =================
# 连接池最大连接数
DB_POOL_MAX=10
# 连接空闲时间（毫秒）超时释放
DB_IDLE_TIMEOUT_MS=30000
# 连接获取超时（毫秒）
DB_CONNECTION_TIMEOUT_MS=5000

# ================= Redis7缓存配置 =================
REDIS_PASSWORD=
# 访问Redis地址
# ⚠️ HOST 取值遵循与 DB_HOST 相同的规则（取决于 Node 进程运行位置）：
#   [Node在docker容器内] 填服务名 redis（docker-compose.local.yml 全容器模式）
#   [Node在宿主机 npm run dev] 填 127.0.0.1（或 localhost）→ 走宿主机端口映射，develop 环境需在宿主机侧自行适配
REDIS_HOST=
REDIS_PORT=6379

# Redis连接示例，业务按需使用
# REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0"

# ================= Docker Compose 全局配置（docker-compose*.yml 顶层读取） =================
# 容器时区
TZ=Asia/Shanghai
# 运行环境：development / production
NODE_ENV=
# Compose 部署健康等待超时（秒），.gitlab-ci.yml 部署阶段使用
COMPOSE_WAIT_TIMEOUT=60

# ================= CI/CD 部署配置（.gitlab-ci.yml 引用，建议放GitLab后台变量） =================
# ⚠️ 以下敏感值和生产信息不要写进提交到仓库的.env，推荐配置在 GitLab → Settings → CI/CD → Variables
# IMAGE_NAME=harbor.mycorp.com/fullstack/my-app     # Harbor镜像前缀
# REGISTRY_USER=                                   # Harbor账号
# REGISTRY_PASSWORD=                               # Harbor密码
# DEPLOY_SERVER_HOST=                             # 生产服务器IP/域名
# DEPLOY_PATH=                                    # 服务器部署目录（含.env和docker-compose.yml）
# DEPLOY_SSH_PRIVATE_KEY=                         # 生产服务器SSH私钥