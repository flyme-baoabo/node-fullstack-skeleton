# ================= 端口配置（双端口模式，env 驱动） =================
# 后端 Express 监听端口（server/src/index.ts / vite.config.ts 代理目标 / scripts/dev-client.mjs 等待端口）
BACKEND_PORT=3006
# 前端 Vite dev server 端口（vite.config.ts / scripts/dev-client.mjs）
VITE_PORT=5173

# ================= PostgreSQL 数据库配置【团队模板，复制为.env后填写真实值】 =================
DB_USER=
DB_PASSWORD=
DB_NAME=
# 访问数据库地址
# 宿主机运行Node填写：127.0.0.1
# Node也放入compose容器网络填写：postgres
DB_HOST=
DB_PORT=5432

# Prisma完整数据库连接串，复制到.env再启用
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ================= 连接池参数（db.config.ts 读取） =================
# 连接池最大连接数
DB_POOL_MAX=10
# 连接空闲时间（毫秒）超时释放
DB_IDLE_TIMEOUT_MS=30000
# 连接获取超时（毫秒）
DB_CONNECTION_TIMEOUT_MS=5000

# ================= Redis7缓存配置 =================
REDIS_PASSWORD=
# 访问Redis地址
# 宿主机运行Node填写：127.0.0.1
# Node也放入compose容器网络填写：redis
REDIS_HOST=
REDIS_PORT=6379

# Redis连接示例，业务按需使用
# REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0"